{
  "name": "vatflow-backend",
  "version": "3.0.0",
  "description": "VATFlow 批量申报系统 - 后端API服务",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/workers/fileProcessor.js",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "hono": "^4.13.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.23.1",
    "nodemailer": "^6.10.1",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@faker-js/faker": "^8.3.1",
    "archiver": "^6.0.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  }
}